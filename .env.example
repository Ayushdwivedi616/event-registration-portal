# ==============================================================
# GLOBAL ENVIRONMENT VARIABLES: Nexus Event Portal
# ==============================================================
# Copy this template to a new file named '.env' inside the 'backend/' folder:
# cp .env.example backend/.env
#
# DO NOT COMMIT THE COMPLETED .ENV FILE TO GITHUB! 
# (The root .gitignore is configured to protect your keys automatically).

# ----------------------------
# Backend Server Configuration
# ----------------------------
PORT=5000

# ----------------------------
# Supabase PostgreSQL Database Credentials
# ----------------------------
# Retrieve these in your Supabase Dashboard under Settings -> API

# Project API URL (e.g. https://abcde12345.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Public Anon Key
SUPABASE_ANON_KEY=your-anon-public-key

# Project Secure Service Role Key (Required to bypass RLS in direct backend scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
