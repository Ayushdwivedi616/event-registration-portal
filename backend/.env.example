# ==============================================================
# ENVIRONMENT VARIABLES TEMPLATE: Event Registration Portal Backend
# ==============================================================
# Copy this file to a new file named '.env' in the same folder:
# cp .env.example .env
#
# Then, replace the placeholders below with your actual Supabase project keys.
# You can find these in your Supabase Dashboard under Settings -> API.

# The port where your backend server will listen (Default: 5000)
PORT=5000

# Your Supabase Project URL (e.g. https://xyzabcd.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon Key (Public Key)
SUPABASE_ANON_KEY=your-anon-public-key

# Your Supabase Service Role Key (Highly recommended for secure backend administration)
# Using the Service Role Key allows your backend server to bypass PostgreSQL Row-Level-Security (RLS)
# and execute inserts/deletes directly on the registrations table safely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
