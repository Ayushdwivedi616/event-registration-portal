# ==============================================================
# GIT WORKFLOW CONFIGURATION: .gitignore
# ==============================================================
# This file tells Git which files and folders to ignore when pushing
# code to GitHub. This is critical for security and keeping the repo clean.

# 1. Database & Environment Secrets (NEVER push these to GitHub!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# 2. Dependency folders (extremely large, downloaded via npm install)
node_modules/
/backend/node_modules/
/frontend/node_modules/
jspm_packages/
web_modules/

# 3. Production Build outputs
dist/
/frontend/dist/
build/
out/
.next/

# 4. Logs and diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# 5. OS & IDE System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
